---
import { layoutLib } from '../lib/site.mjs';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { o } = Astro.props;
const dir = layoutLib.LB[o.locale].dir;
---
<!doctype html>
<html lang={o.locale} dir={dir} data-theme="light">
  <head>
    <SeoHead o={o} />
  </head>
  <body>
    <a class="skip" href="#main">{o.T.skip}</a>
    <div class="glow"></div>
    <Header o={o} />
    <main id="main"><slot /></main>
    <Footer o={o} />
    <Fragment set:html={o.afterFooter || ''} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <Fragment set:html={o.scripts} />
  </body>
</html>
